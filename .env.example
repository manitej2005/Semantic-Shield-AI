# =================================================================
# SemanticShield AI Environment Variable Configuration Template
# =================================================================
# Instructions: Copy this file to .env before starting the application.
# NEVER commit your actual .env file or real API keys to repository.

# Application Environment Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Google Gemini LLM API Key (used for semantic threat analysis)
# Obtain key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Threat Intelligence Provider API Keys (Optional - Fallbacks to mock mode if omitted)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
URLSCAN_API_KEY=your_urlscan_api_key_here
WHOIS_API_KEY=your_whois_api_key_here

# Security & CORS Settings
SECRET_KEY=your_secret_key_here_change_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,chrome-extension://*
