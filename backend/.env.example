# =================================================================
# SemanticShield AI Backend Environment Configuration Template
# =================================================================

# Server & Runtime Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Google Gemini LLM API Key (required for live AI analysis)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Threat Intelligence Provider API Keys (Optional - fallback to mock mode if omitted)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
URLSCAN_API_KEY=your_urlscan_api_key_here
WHOIS_API_KEY=your_whois_api_key_here

# Threat Intel Cache & Settings
THREAT_INTEL_CACHE_TTL=3600
THREAT_INTEL_MOCK_MODE=True

# Security & CORS Settings
SECRET_KEY=your_secret_key_here
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,chrome-extension://*

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./semanticshield.db
DATABASE_ECHO=False
DATABASE_AUTO_MIGRATE=True
DATABASE_SEED_DEV_DATA=True
